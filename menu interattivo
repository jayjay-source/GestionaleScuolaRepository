public void simulaInterrogazione() {
        ClasseScolastica classe = scegliClasse();
        if (classe == null) return;

        Docente docente = scegliDocente(classe.getDocentiClasse());
        if (docente == null) return;

        classe.interrogazione(docente.getMateria());
    }


    //implementazione metodo per valutazione docenti
    public void valutaDocente() {
        ClasseScolastica classe = scegliClasse();
        if (classe == null) return;

        Docente docente = scegliDocente(classe.getDocentiClasse());
        if (docente == null) return;

        ArrayList<Studente> listaStudenti = classe.getStudentiClasse();

        ArrayList<Voto> listaVoti = new ArrayList<>();

        for (Studente s : listaStudenti) {
            listaVoti.addAll(s.getListaVoti());
        }
        int sommaVoti = 0;
        int votiTot = 0;
        for (Voto v : listaVoti) {
            if (v.getNomeMateria().equals(docente.getMateria())) {
                sommaVoti += v.getValutazioneNumerica();
                votiTot ++;
            }
        }

        double mediaDocente = sommaVoti/votiTot;
        System.out.println("La media dei voti dati dal docente " + docente.getNome() + " " + docente.getCognome() + " è pari a: " + mediaDocente);

        if (docente.valutaPrestazione(mediaDocente)) {
            System.out.println("Il docente si è meritato un aumento per gli ottimi risultati");
            aumentoStipendio(docente);
        }

    }

    //implementazione metodo per gestire gli stipendi
    public void aumentoStipendio(Docente docente) {
        
        System.out.println("Di quale percentuale aumentare lo stipendio al docente " + docente.getNome() + " " + docente.getCognome() + "?");
        System.out.println("Stipendio attuale: " + docente.getStipendio());
        double percentuale = tastiera.nextDouble();

        docente.aumentaStipendio(percentuale);

    }


